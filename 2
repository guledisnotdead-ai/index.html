<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Renewable Energy for Essential Loads — Design Proposal Template</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

  :root{
    --navy:#14213D; --navy-deep:#0D1729;
    --fog:#E9EDEA; --fog-dim:#DCE1DC;
    --amber:#F0A83C; --teal:#3E8E82; --coral:#E2604F;
    --ink:#1B1F1D; --sub:#4A524C;
    --display:'Space Grotesk',sans-serif; --body:'IBM Plex Sans',sans-serif; --mono:'IBM Plex Mono',monospace;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }
  body{ font-family:var(--body); background:#fff; color:var(--ink); line-height:1.65; }
  a{ color:inherit; text-decoration:none; }
  section{ position:relative; }
  .wrap{ max-width:1080px; margin:0 auto; padding:0 32px; }
  h1,h2,h3,h4{ font-family:var(--display); letter-spacing:-0.01em; }
  .placeholder{ color:var(--sub); font-style:italic; }
  :focus-visible{ outline:2px solid var(--amber); outline-offset:3px; }
  .eyebrow{
    font-family:var(--mono); font-size:0.7rem; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--teal); display:flex; align-items:center; gap:10px;
  }
  .eyebrow .num{
    font-family:var(--mono); font-size:0.7rem; color:var(--amber); border:1px solid var(--amber);
    border-radius:2px; padding:1px 6px;
  }
  .lede{ color:var(--sub); max-width:70ch; margin-top:14px; }

  /* NAV */
  header{
    position:sticky; top:0; z-index:100; background:rgba(20,33,61,0.95);
    backdrop-filter:blur(8px); border-bottom:1px solid rgba(240,168,60,0.18);
  }
  nav{ max-width:1080px; margin:0 auto; padding:14px 32px; display:flex; align-items:center; justify-content:space-between; }
  .brand{ display:flex; align-items:center; gap:10px; font-family:var(--display); font-weight:600; color:var(--fog); font-size:0.95rem; }
  .brand svg{ width:22px; height:22px; }
  .navlinks{ display:flex; gap:18px; flex-wrap:wrap; }
  .navlinks a{
    font-family:var(--mono); font-size:0.7rem; letter-spacing:0.03em; text-transform:uppercase;
    color:rgba(233,237,234,0.6); padding:4px 0; border-bottom:1px solid transparent;
    transition:color .2s ease, border-color .2s ease; white-space:nowrap;
  }
  .navlinks a span{ color:var(--amber); margin-right:4px; }
  .navlinks a:hover, .navlinks a.active{ color:var(--fog); border-color:var(--amber); }
  .navtoggle{ display:none; background:none; border:none; cursor:pointer; width:30px; height:22px; position:relative; }
  .navtoggle span{ position:absolute; left:0; right:0; height:2px; background:var(--fog); }
  .navtoggle span:nth-child(1){ top:1px; } .navtoggle span:nth-child(2){ top:10px; } .navtoggle span:nth-child(3){ top:19px; }

  /* HERO */
  .hero{
    background:linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 100%);
    color:var(--fog); padding:88px 32px 64px;
  }
  .hero-inner{ max-width:1080px; margin:0 auto; }
  .hero .eyebrow{ color:var(--amber); }
  .hero .eyebrow::before{ content:""; width:22px; height:1px; background:var(--amber); display:inline-block; }
  .hero h1{ font-size:clamp(1.9rem,3.6vw,2.9rem); margin:16px 0 14px; font-weight:600; max-width:22ch; }
  .hero p.lede{ color:rgba(233,237,234,0.75); }
  .meta-row{
    display:flex; gap:32px; flex-wrap:wrap; margin-top:32px; padding-top:24px;
    border-top:1px solid rgba(233,237,234,0.15);
  }
  .meta-item{ font-family:var(--mono); font-size:0.78rem; }
  .meta-item .k{ color:rgba(233,237,234,0.5); text-transform:uppercase; letter-spacing:0.05em; font-size:0.68rem; display:block; margin-bottom:4px; }
  .meta-item .v{ color:var(--fog); }

  .schema-strip{ margin-top:40px; opacity:0.9; }
  .schema-strip svg{ width:100%; height:auto; }

  /* SECTIONS */
  .band{ padding:76px 0; border-bottom:1px solid var(--fog-dim); }
  .section-head{ max-width:680px; margin-bottom:38px; }
  .section-head h2{ font-size:clamp(1.4rem,2.6vw,1.9rem); margin-top:12px; }

  /* Team contributions */
  .contrib-table, .cost-table, .reqs-table, .results-table{
    width:100%; border-collapse:collapse; font-size:0.92rem; margin-top:8px;
  }
  .contrib-table th, .cost-table th, .reqs-table th, .results-table th{
    text-align:left; font-family:var(--mono); font-size:0.68rem; letter-spacing:0.05em; text-transform:uppercase;
    color:var(--sub); padding:10px 14px; border-bottom:2px solid var(--ink);
  }
  .contrib-table td, .cost-table td, .reqs-table td, .results-table td{
    padding:12px 14px; border-bottom:1px solid var(--fog-dim); vertical-align:top;
  }
  .cost-table tfoot td{ font-weight:600; border-top:2px solid var(--ink); border-bottom:none; }

  /* Journey map */
  .journey{ display:grid; grid-template-columns:repeat(5,1fr); gap:0; margin-top:8px; }
  .journey-stage{
    border-top:3px solid var(--teal); padding:18px 16px 0; position:relative;
  }
  .journey-stage:not(:last-child)::after{
    content:"→"; position:absolute; right:-14px; top:-14px; color:var(--fog-dim); font-size:1rem;
  }
  .journey-stage h4{ font-size:0.88rem; margin-bottom:6px; }
  .journey-stage p{ font-size:0.82rem; color:var(--sub); }

  /* Needs cards */
  .card-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:8px; }
  .need-card{ border:1px solid var(--fog-dim); border-radius:6px; padding:22px; }
  .need-card h4{ font-size:0.95rem; margin-bottom:8px; }
  .need-card p{ font-size:0.85rem; color:var(--sub); }
  .priority{
    display:inline-block; margin-top:10px; font-family:var(--mono); font-size:0.65rem;
    letter-spacing:0.05em; text-transform:uppercase; padding:2px 8px; border-radius:20px; border:1px solid currentColor;
  }
  .priority.high{ color:var(--coral); }
  .priority.med{ color:var(--amber); }
  .priority.low{ color:var(--teal); }

  /* Idea cards */
  .idea-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:8px; }
  .idea-card{ background:var(--fog); border-radius:6px; padding:18px; font-size:0.85rem; }
  .idea-card .id{ font-family:var(--mono); font-size:0.68rem; color:var(--teal); }
  .idea-card h4{ font-size:0.9rem; margin:6px 0 4px; }
  .idea-card p{ color:var(--sub); font-size:0.8rem; }

  /* Decision matrix */
  .matrix-wrap{ overflow-x:auto; margin-top:20px; }
  .matrix{ width:100%; border-collapse:collapse; font-size:0.85rem; min-width:640px; }
  .matrix th, .matrix td{ padding:10px 14px; text-align:center; border:1px solid var(--fog-dim); }
  .matrix th{ font-family:var(--mono); font-size:0.68rem; text-transform:uppercase; background:var(--navy); color:var(--fog); }
  .matrix td:first-child, .matrix th:first-child{ text-align:left; }
  .matrix .winner{ background:rgba(240,168,60,0.14); font-weight:600; }
  .matrix .total-row td{ font-weight:600; border-top:2px solid var(--ink); }

  /* Prototype */
  .proto-grid{ display:grid; grid-template-columns:1fr 1fr; gap:44px; align-items:start; }
  .proto-figure{
    border:1px dashed var(--fog-dim); border-radius:6px; aspect-ratio:4/3;
    display:flex; align-items:center; justify-content:center; color:var(--sub);
    font-family:var(--mono); font-size:0.8rem; text-align:center; padding:24px; background:var(--fog);
  }

  /* Timeline */
  .timeline{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:8px; }
  .phase{ border-left:3px solid var(--amber); padding-left:14px; }
  .phase .ph{ font-family:var(--mono); font-size:0.68rem; color:var(--amber); text-transform:uppercase; letter-spacing:0.05em; }
  .phase h4{ font-size:0.92rem; margin:6px 0 4px; }
  .phase p{ font-size:0.82rem; color:var(--sub); }

  /* Recommendations */
  .rec-list{ margin-top:8px; }
  .rec-item{ display:flex; gap:16px; padding:18px 0; border-bottom:1px solid var(--fog-dim); }
  .rec-item .n{ font-family:var(--display); font-size:1.4rem; color:var(--teal); font-weight:600; min-width:36px; }
  .rec-item h4{ font-size:1rem; margin-bottom:4px; }
  .rec-item p{ font-size:0.9rem; color:var(--sub); }

  /* References */
  .ref-list{ margin-top:8px; font-size:0.9rem; }
  .ref-item{ padding-left:2.4em; text-indent:-2.4em; margin-bottom:14px; color:var(--sub); }
  .ref-note{
    background:var(--fog); border-left:3px solid var(--teal); padding:14px 18px; margin-top:24px;
    font-size:0.85rem; border-radius:4px;
  }

  footer{ background:var(--navy-deep); color:rgba(233,237,234,0.55); padding:36px 0; font-size:0.8rem; }
  .footer-inner{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; font-family:var(--mono); }

  @media (max-width:900px){
    .navlinks{
      position:fixed; top:58px; left:0; right:0; bottom:0; background:var(--navy-deep);
      flex-direction:column; padding:24px 32px; transform:translateX(100%); transition:transform .3s ease; overflow-y:auto;
    }
    .navlinks.open{ transform:translateX(0); }
    .navlinks a{ padding:12px 0; border-bottom:1px solid rgba(233,237,234,0.08); width:100%; }
    .navtoggle{ display:block; }
    .journey{ grid-template-columns:repeat(2,1fr); gap:24px 16px; }
    .journey-stage::after{ display:none; }
    .card-grid{ grid-template-columns:1fr 1fr; }
    .idea-grid{ grid-template-columns:1fr 1fr; }
    .proto-grid{ grid-template-columns:1fr; }
    .timeline{ grid-template-columns:1fr 1fr; }
  }
  @media (max-width:560px){
    .card-grid, .idea-grid, .journey, .timeline{ grid-template-columns:1fr; }
    .band{ padding:56px 0; }
  }
  @media (prefers-reduced-motion:reduce){ *{ scroll-behavior:auto !important; } }
</style>
</head>
